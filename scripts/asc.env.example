# Copie este arquivo para scripts/asc.env e preencha com os seus valores.
# scripts/asc.env NÃO é versionado (está no .gitignore) — contém segredos.
#
# Onde obter:
#   App Store Connect > Usuários e Acesso > Integrações >
#   Chaves da App Store Connect API
#
#   - ASC_ISSUER_ID: o "Issuer ID" no topo da página (UUID).
#   - ASC_KEY_ID:    o "Key ID" da chave gerada (10 caracteres).
#   - ASC_KEY_PATH:  caminho do .p8 baixado (baixável só uma vez!).
#                    Recomendado: ~/.appstoreconnect/private_keys/AuthKey_<KEYID>.p8

ASC_KEY_ID="XXXXXXXXXX"
ASC_ISSUER_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
ASC_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8"
